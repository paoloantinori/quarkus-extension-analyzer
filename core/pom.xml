<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>quarkus-extension-analyzer-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quarkus-extension-analyzer-core</artifactId>
  <packaging>jar</packaging>

  <name>quarkus-extension-analyzer :: core</name>
  <description>
    The classification engine shared by the mojo and (planned) extension shells:
    the three-signal Analyzer, the report model, and ignore-list generation.
    Pure Java plus the Quarkus bootstrap API (ApplicationModel/ResolvedDependency,
    stable across 3.x). See docs/REARCH-PLAN.md.
  </description>

  <dependencies>
    <!-- ApplicationModel + ExtensionCapabilities + ResolvedDependency types the Analyzer consumes. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-bootstrap-maven-resolver</artifactId>
      <version>${quarkus.version}</version>
    </dependency>

    <!-- Signal 1 source D (@ConfigMapping/@ConfigRoot) and signal 2's extension bytecode probe. -->
    <dependency>
      <groupId>io.smallrye</groupId>
      <artifactId>jandex</artifactId>
    </dependency>

    <!-- Signal 1 source B (META-INF/quarkus-extension.yaml) and best-effort application.yaml reading. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- Signal 1 source C (quarkus-config-doc/quarkus-config-model.json) and JSON report output. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Signal 2 for plain (non-extension) jars: standard bytecode-reference semantics, comparable to
         maven-dependency-plugin:analyze. Also the ASM dependency reused by DeploymentVocabulary. -->
    <dependency>
      <groupId>org.apache.maven.shared</groupId>
      <artifactId>maven-dependency-analyzer</artifactId>
      <version>1.17.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
      <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.9</version>
      <scope>test</scope>
    </dependency>
  </dependencies></project>
