<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.paoloantinori.qea</groupId>
  <artifactId>quarkus-extension-analyzer-spike</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>quarkus-extension-analyzer :: M1 spike</name>
  <description>
    Throwaway spike validating the two risky assumptions of docs/DESIGN.md:
    (1) per-extension config roots are recoverable at tool runtime,
    (2) the Quarkus bootstrap ApplicationModel is resolvable from plain Java.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Must match the Quarkus version of the validation bench (apicurio-registry 3.3.2-SNAPSHOT). -->
    <quarkus.version>3.38.2</quarkus.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Assumption 2: ApplicationModel resolution outside quarkus-maven-plugin. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-bootstrap-maven-resolver</artifactId>
      <version>${quarkus.version}</version>
    </dependency>

    <!-- Assumption 1, source D: @ConfigMapping / @ConfigRoot scanning of runtime jars. -->
    <dependency>
      <groupId>io.smallrye</groupId>
      <artifactId>jandex</artifactId>
    </dependency>

    <!-- Assumption 1, source B: META-INF/quarkus-extension.yaml. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- Assumption 1, source C: META-INF/quarkus-config-doc/quarkus-config-model.json. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>io.github.paoloantinori.qea.spike.Spike</mainClass>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
