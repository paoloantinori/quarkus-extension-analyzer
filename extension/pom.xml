<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>quarkus-extension-analyzer-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>quarkus-extension-analyzer</artifactId>
  <packaging>jar</packaging>

  <name>quarkus-extension-analyzer :: extension runtime</name>
  <description>
    The runtime artifact of the Quarkus extension form (TASK-19). Near-empty: the
    extension's value runs at BUILD time in the -deployment module (a @BuildStep
    that classifies declared extensions via the shared core, reading ArC's bean
    index). This runtime jar exists because Quarkus extensions are a
    runtime+deployment pair; users add this artifactId to their app pom, and
    quarkus-extension.properties points Quarkus to the deployment module. See
    docs/REARCH-PLAN.md.
  </description>

  <dependencies>
    <!-- Quarkus extension invariant: the runtime module must depend on the runtime counterparts
         of every deployment dependency the deployment module declares. Since the deployment module
         depends on quarkus-core-deployment and quarkus-arc-deployment, the runtime must carry
         quarkus-core and quarkus-arc. The extension-descriptor goal enforces this. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The extension-descriptor goal belongs on the RUNTIME module. It reads the
           deployment-artifact GAV from quarkus-extension.properties, resolves the deployment jar,
           scans its classes for @BuildStep methods, and writes META-INF/quarkus-build-steps.list
           into the deployment jar. Without this, @BuildStep methods are invisible to augmentation. -->
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-extension-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>extension-descriptor</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
