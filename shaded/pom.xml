<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>quarkus-extension-analyzer-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>quarkus-extension-analyzer-shaded</artifactId>
  <packaging>jar</packaging>

  <name>quarkus-extension-analyzer :: shaded runner (TASK-20)</name>
  <description>
    Self-contained runner for the mojo: bundles core + the Quarkus bootstrap resolver
    with every io.quarkus.* class RELOCATED to io.github.paoloantinori.qea.internal, so
    projects that expose their own Quarkus bootstrap classes into the Maven build realm
    (e.g. via quarkus-maven-plugin as a build extension, the camel-quarkus IT case) can
    no longer collide with the embedded version (the TASK-20 LinkageError). The entry
    class uses only JDK and Maven-API types at its boundary and returns the report as
    JSON, so no relocated type ever crosses the classloader line.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.paoloantinori</groupId>
      <artifactId>quarkus-extension-analyzer-core</artifactId>
    </dependency>
    <!-- The model resolution to be relocated; becomes part of the shaded jar. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-bootstrap-maven-resolver</artifactId>
      <version>${quarkus.version}</version>
    </dependency>

    <!-- Maven API types used at the runner boundary (shared through the parent realm at runtime,
         so NOT relocated; provided scope keeps them out of the shaded jar). -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-impl</artifactId>
      <version>${resolver.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-settings-builder</artifactId>
      <version>${maven.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The relocation pin (below) must run AFTER shade (package phase), so it is an IT. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.6</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <!-- No filter: core + all transitives land in the shaded jar. -->
              <relocations>
                <!-- The whole point of TASK-20: our embedded Quarkus bootstrap must be invisible
                     to the project realm's own (possibly different) Quarkus classes. The patterns
                     are PACKAGE-specific with a trailing dot on purpose: a bare "io.quarkus"
                     pattern prefix-matches the annotation engine's DOMAIN string literals
                     ("io.quarkus:quarkus-rest-jackson", "io.quarkus.scheduler.Scheduled"), which
                     the shader rewrites into internal.* names that can never match the real GAs
                     and FQCNs in the report and the app index, silently killing every rule in the
                     mojo form (found while validating TASK-28). These seven packages are exactly
                     the io.quarkus.* content embedded here (verified against the shaded jar). -->
                <relocation>
                  <pattern>io.quarkus.bootstrap.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.bootstrap.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.commons.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.commons.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.fs.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.fs.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.maven.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.maven.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.paths.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.paths.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.sbom.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.sbom.</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>io.quarkus.util.</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.quarkus.util.</shadedPattern>
                </relocation>
                <!-- Jandex (a core dependency) is relocated for hermeticity; the smallrye-common
                     transitives of the bootstrap resolver are NOT relocated (a pre-existing TASK-20
                     tradeoff: they are not typically present in project realms). -->
                <relocation>
                  <pattern>org.jboss.jandex</pattern>
                  <shadedPattern>io.github.paoloantinori.qea.internal.jandex</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <!-- Rewrites META-INF/services entries so ServiceLoader inside the shaded
                     bootstrap resolves the relocated class names. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <!-- Keep the original (unshaded) classes of THIS module too: the runner entry class
                   lives here and references only JDK/Maven types, so it does not need relocation. -->
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
