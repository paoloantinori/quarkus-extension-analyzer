<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paoloantinori</groupId>
    <artifactId>quarkus-extension-analyzer-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>quarkus-extension-analyzer-deployment</artifactId>
  <packaging>jar</packaging>

  <name>quarkus-extension-analyzer :: extension deployment</name>
  <description>
    The deployment module of the Quarkus extension form (TASK-19): the @BuildStep
    that consumes AppModelProviderBuildItem (ApplicationModel) and
    BeanArchiveIndexBuildItem (ArC's bean index), runs the shared core's Analyzer,
    and resolves annotation-consumer false positives the standalone mojo cannot.
  </description>

  <dependencies>
    <!-- The shared classification engine. -->
    <dependency>
      <groupId>io.github.paoloantinori</groupId>
      <artifactId>quarkus-extension-analyzer-core</artifactId>
    </dependency>
    <!-- The runtime artifact of THIS extension. Quarkus requires the deployment module to depend
         on its runtime module (the bootstrap classloader chain); a deployment without this is
         rejected with "does not appear to depend on the corresponding runtime artifact". -->
    <dependency>
      <groupId>io.github.paoloantinori</groupId>
      <artifactId>quarkus-extension-analyzer</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Quarkus deployment API: @BuildStep, BuildItem, BuildProducer. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-core-deployment</artifactId>
      <version>${quarkus.version}</version>
    </dependency>
    <!-- ArC deployment: BeanArchiveIndexBuildItem (the app's Jandex bean index). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc-deployment</artifactId>
      <version>${quarkus.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.5</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.9</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Generate META-INF/quarkus-build-steps.list by scanning target/classes for @BuildStep
           methods (using Jandex), replacing the static list file. Runs during process-classes,
           after compile. This avoids the quarkus-extension-maven-plugin reactor-ordering issue
           (which needs the deployment jar before the runtime module builds). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-build-steps-list</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.github.paoloantinori.qea.deployment.BuildStepsListGenerator</mainClass>
              <arguments><argument>${project.build.outputDirectory}</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
